# Docker Compose reads .env. Direct Python execution needs shell environment variables.
CROSCAN_AUTH=demo
CROSCAN_PORT=127.0.0.1:8765
CROSCAN_KEEP_SUBMISSIONS=0
# Set a private random value locally before reading/administering QA reports.
QA_TOKEN=
CROSCAN_URL=http://127.0.0.1:8765
# Direct Python default; Compose overrides this to its llm service.
LLM_URL=http://127.0.0.1:8000/v1/chat/completions
LLM_MODEL=Raon-1-mini-preview
